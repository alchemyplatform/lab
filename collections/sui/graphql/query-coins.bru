meta {
  name: Query Coin Balances
  type: graphql
  seq: 3
}

post {
  url: https://sui-mainnet.g.alchemy.com/graphql/v2/{{api_key}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetCoinBalances($owner: SuiAddress!, $coinType: String) {
    owner(address: $owner) {
      address
      balance(type: $coinType) {
        coinType {
          repr
        }
        coinObjectCount
        totalBalance
      }
      balances(first: 10) {
        nodes {
          coinType {
            repr
          }
          coinObjectCount
          totalBalance
        }
        pageInfo {
          hasNextPage
          endCursor
        }
      }
      coins(first: 10, type: $coinType) {
        nodes {
          coinBalance
          contents {
            type {
              repr
            }
          }
        }
        pageInfo {
          hasNextPage
          endCursor
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "owner": "0x94f1a597b4e8f709a396f7f6b1482bdcd65a673d111e49286c527fab7c2d0961",
    "coinType": "0x2::sui::SUI"
  }
}

docs {
  Query coin balances for an address using GraphQL.
  
  This query retrieves:
  - Specific coin type balance
  - All coin balances for the address
  - Individual coin objects with their balances
  
  **Variables:**
  - owner: The Sui address to query
  - coinType: Optional specific coin type (defaults to SUI)
}
