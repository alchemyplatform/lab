meta {
  name: alchemy_getAssetTransfersV2
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "alchemy_getAssetTransfersV2",
    "params": [
      {
        "block": "0x13738ca",
        "category": [
          "erc20",
          "erc721",
          "external"
        ],
        "order": "asc",
        "maxCount": "0x5"
      }
    ],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  V2 variant for asset transfers (single block or filters).
  Args: filter object (see docs).
  Returns: {transfers: [...], pageKey?}
}
