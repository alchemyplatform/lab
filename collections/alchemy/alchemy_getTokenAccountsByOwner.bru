meta {
  name: alchemy_getTokenAccountsByOwner
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "alchemy_getTokenAccountsByOwner",
    "params": [
      "H3i9m5sHq3Hhd3uCJ3K1qVdQ7gH3snqA6Zt7fKrYb7gT",
      {
        "programId": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
      }
    ],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  Solana: Returns token accounts by owner.
  Args:
  - owner: base58
  - filter: {mint|programId}
  Returns: token accounts list.
}
