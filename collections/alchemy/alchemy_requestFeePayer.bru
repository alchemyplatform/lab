meta {
  name: alchemy_requestFeePayer
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": "bru",
    "method": "alchemy_requestFeePayer",
    "params": [
      {
        "message": "base64-encoded-solana-tx"
      }
    ]
  }
}

settings {
  encodeUrl: true
}

docs {
  Solana: Returns a signed transaction sponsored by Alchemy's fee payer.
  Args:
  - {message}
  Returns: signed transaction with fee payer.
}
