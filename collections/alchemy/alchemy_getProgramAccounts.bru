meta {
  name: alchemy_getProgramAccounts
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "alchemy_getProgramAccounts",
    "params": [
      "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",
      {
        "encoding": "jsonParsed",
        "withContext": true
      }
    ],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns all accounts owned by the provided program id (Solana).
  Args:
  - programId: base58
  - config?: with filters and encoding
  Returns: array of accounts.
}
