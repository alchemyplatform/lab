meta {
  name: getSupply
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getSupply",
    "params": [],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns information about the current supply of lamports.
  
  **Args**:
  - Configuration (optional): Optional configuration object containing additional settings
  
  **Returns**: An RpcResponse JSON object containing the current supply information
}

