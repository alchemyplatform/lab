meta {
  name: getBlockCommitment
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getBlockCommitment",
    "params": [
      237158054
    ],
