meta {
  name: getLargestAccounts
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getLargestAccounts",
    "params": [],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the 20 largest accounts, by lamport balance.
  
  **Args**:
  - Configuration (optional): Optional configuration object
  
  **Returns**: An array of objects containing the address of the account and its lamport balance
}

