meta {
  name: getTransaction
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getTransaction",
    "params": [
      "2nBhEBYYvfaAe16UMNqRHre4YNSskvuYgx3M6E4JP1oDYvZEJHvoPzyUidNgNX5r9sTyN1J9UxtbCXy2rqYcuyuv"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns transaction details for a confirmed transaction.
  
  **Args**:
  - Transaction signature (required): Transaction signature as a base-58 encoded string
  - Configuration (optional): Optional configuration object containing additional settings
  
  **Returns**: The details of a confirmed transaction
}

