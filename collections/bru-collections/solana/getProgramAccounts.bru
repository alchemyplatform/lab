meta {
  name: getProgramAccounts
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getProgramAccounts",
    "params": [
      "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns all accounts owned by the provided program Pubkey.
  
  **Args**:
  - Pubkey (required): The Pubkey of the program
  - Configuration (optional): Optional configuration object
  
  **Returns**: An array of JSON objects containing program account details
}

