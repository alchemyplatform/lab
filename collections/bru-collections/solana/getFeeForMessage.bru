meta {
  name: getFeeForMessage
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getFeeForMessage",
    "params": [
      "AQABAgIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEBAQAA"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Get the fee the network will charge for a particular Message.
  
  **Args**:
  - Message (required): Base-64 encoded Message
  - Configuration (optional): Optional configuration object
  
  **Returns**: The fee corresponding to the message at the specified blockhash
}

