meta {
  name: getAccountInfo
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getAccountInfo",
    "params": [
      "GwsPP9HHhCvEQeu3HTFzsVL6DEtnnYw4ALEtA3fMBC9Q"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns all information associated with the account of provided Pubkey.
  
  **Args**:
  - Pubkey (required): Pubkey of the account to query
  - Configuration (optional): Optional configuration object for additional settings
  
  **Returns**: Account information including balance, ownership, and other relevant data
}

