meta {
  name: getTokenSupply
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getTokenSupply",
    "params": [
      "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the total supply of an SPL Token type.
  
  **Args**:
  - Token Mint Pubkey (required): The Pubkey of the token Mint to query
  - Configuration (optional): Optional configuration object containing additional settings
  
  **Returns**: The total supply of the specified SPL Token
}

