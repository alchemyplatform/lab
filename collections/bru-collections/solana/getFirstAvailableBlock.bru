meta {
  name: getFirstAvailableBlock
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getFirstAvailableBlock",
    "params": [],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the slot of the lowest confirmed block that has not been purged from the ledger.
  
  **Returns**: The slot number of the lowest confirmed block that is still available in the ledger
}

