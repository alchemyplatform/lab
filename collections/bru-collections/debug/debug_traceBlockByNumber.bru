meta {
  name: debug_traceBlockByNumber
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "debug_traceBlockByNumber",
    "params": [
      "0x13738ca",
      {
        "tracer": "callTracer"
      }
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Traces all transactions in the specified block by number.
  Args:
  - blockNumber: hex block number
  - options: tracer options
  Returns: Array/object of traces for each tx.
}
