meta {
  name: eth_createAccessList
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "eth_createAccessList",
    "params": [
      {
        "from": "0xd8dA6BF26964aF9D7eEd9e03e53415D37aA96045",
        "to": "0x00000000006c3852cbEf3e08E8dF289169EdE581",
        "data": "0x"
      },
      "latest"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Generates an access list for a transaction.
  
  **Args**:
  - Transaction: Transaction call object (from,to,gas,gasPrice|maxFeePerGas|maxPriorityFeePerGas,value,data).
  - Block: Block selector: hex block number (0x...), or tag 'latest'|'safe'|'finalized'|'earliest'|'pending'.
  
  **Returns**: Access list result
}
