meta {
  name: eth_getBlockByHash
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "eth_getBlockByHash",
    "params": [
      "0xdc0818cf78f21a8e70579cb46a43643f78291264dda342ae31049421c82d21ae",
      false
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns information about a block by hash.
  
  **Args**:
  - Block hash: 32-byte 0x-prefixed hash.
  - Hydrated transactions: hydrated
  
  **Returns**: Returns JSON-RPC result; see client docs.
  
  **Edge cases & notes**:
  - Returns null if block hash not found on the canonical chain.
  - On post-Merge Ethereum, 'nonce' is 0x0 and uncles count is 0.
}
