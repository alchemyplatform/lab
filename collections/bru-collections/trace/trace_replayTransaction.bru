meta {
  name: trace_replayTransaction
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "trace_replayTransaction",
    "params": [
      "0x07104ffdf32b06b90e604f23c7b4e21fc985b68c5bb8c13140d0d3d2e151a385",
      [
        "trace",
        "vmTrace",
        "stateDiff"
      ]
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Replays a transaction and returns requested traces.
  Args:
  - txHash: 32-byte hash
  - traceTypes: array (trace|vmTrace|stateDiff)
  Returns: Traces for the transaction execution.
}
