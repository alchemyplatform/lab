meta {
  name: trace_block
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "trace_block",
    "params": [
      "0x13738ca"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns traces created at given block number.
  Args:
  - blockNumber: hex block number.
  Returns: Array of trace objects for that block.
}
