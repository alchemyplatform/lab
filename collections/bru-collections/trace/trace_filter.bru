meta {
  name: trace_filter
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "trace_filter",
    "params": [
      {
        "fromBlock": "0x13738ca",
        "toBlock": "0x13738ca",
        "fromAddress": [
          "0xd8dA6BF26964aF9D7eEd9e03e53415D37aA96045"
        ],
        "toAddress": [
          "0x6B175474E89094C44Da98b954EedeAC495271d0F"
        ]
      }
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns traces matching given filter criteria.
  Args:
  - filter: {fromBlock?, toBlock?, fromAddress?, toAddress?, after?, count?}
  Returns: Array of trace objects.
}
