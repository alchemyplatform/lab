meta {
  name: debug_executionWitness
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "debug_executionWitness",
    "params": [],
    "id": "bru"
  }
}

settings {
  encodeUrl: true
}

docs {
  Allows for re-execution of a block with the purpose of generating an execution witness
}
