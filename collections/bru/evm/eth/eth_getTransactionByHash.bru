meta {
  name: eth_getTransactionByHash
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "eth_getTransactionByHash",
    "params": [
      "0x07104ffdf32b06b90e604f23c7b4e21fc985b68c5bb8c13140d0d3d2e151a385"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the information about a transaction requested by transaction hash.
  
  **Args**:
  - Transaction hash: 32-byte 0x-prefixed hash.
  
  **Returns**: Returns JSON-RPC result; see client docs.
  
  **Edge cases & notes**:
  - Returns null if transaction hash is unknown or pruned.
  - Pending transactions have null blockHash and blockNumber.
}
