meta {
  name: alchemy_getTokenLargestAccounts
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "alchemy_getTokenLargestAccounts",
    "params": [
      "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the top token holders for a mint (token-specific support).
  Args:
  - contractAddress
  Returns: holders list.
}
