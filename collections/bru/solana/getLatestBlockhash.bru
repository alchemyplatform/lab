meta {
  name: getLatestBlockhash
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getLatestBlockhash",
    "params": [],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the latest blockhash.
  
  **Args**:
  - Configuration (optional): A configuration object with optional fields for specifying commitment and minimum context slot
  
  **Returns**: RpcResponse object with blockhash information
}

