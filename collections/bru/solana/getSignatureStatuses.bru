meta {
  name: getSignatureStatuses
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getSignatureStatuses",
    "params": [
      [
        "5VERv8NMvzbJMEkV8xnrLkEaWRtSz9CosKDYjCJjBRnbJLgp8uirBgmQpjKhoR4tjF3ZpRzrFmBV6UjKdiSZkQUW"
      ]
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the statuses of a list of transaction signatures.
  
  **Args**:
  - Signatures (required): An array of transaction signatures to confirm
  - Configuration (optional): Optional configuration object
  
  **Returns**: An array containing the status of each transaction signature
}

