meta {
  name: getBlockHeight
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getBlockHeight",
    "params": [],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the current block height of the node.
  
  **Args**:
  - Configuration (optional): Optional configuration object containing additional request parameters
  
  **Returns**: The current block height, as a u64 integer
}

