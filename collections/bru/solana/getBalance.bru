meta {
  name: getBalance
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getBalance",
    "params": [
      "GwsPP9HHhCvEQeu3HTFzsVL6DEtnnYw4ALEtA3fMBC9Q"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the lamport balance of the account of the provided Pubkey.
  
  **Args**:
  - Pubkey (required): Pubkey of the account to query
  - Configuration (optional): Optional configuration object containing additional settings
  
  **Returns**: Lamport balance of the account queried
}

