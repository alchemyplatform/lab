meta {
  name: getEpochInfo
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getEpochInfo",
    "params": [],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns information about the current epoch.
  
  **Args**:
  - Configuration (optional): Optional configuration object
  
  **Returns**: An object containing information about the current epoch
}

