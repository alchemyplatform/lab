meta {
  name: getSlot
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getSlot",
    "params": [],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the slot that has reached the given or default commitment level.
  
  **Args**:
  - Configuration (optional): Optional configuration object containing additional settings
  
  **Returns**: The current slot at the specified commitment level
}

