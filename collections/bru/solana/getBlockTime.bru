meta {
  name: getBlockTime
  type: http
}

post {
  url: https://solana-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getBlockTime",
    "params": [
      237158054
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the estimated production time of a block.
  
  **Args**:
  - block (required): Block number, identified by Slot
  
  **Returns**: The estimated production time of the block as a Unix timestamp
}

