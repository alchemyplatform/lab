meta {
  name: trace_transaction
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "trace_transaction",
    "params": [
      "0x07104ffdf32b06b90e604f23c7b4e21fc985b68c5bb8c13140d0d3d2e151a385"
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns all traces for the given transaction hash.
  Args:
  - txHash: 32-byte 0x-prefixed transaction hash.
  Returns: Array of trace objects (type, action, result, traceAddress, subtraces, error).
}
