meta {
  name: trace_get
  type: http
}

post {
  url: https://eth-mainnet.g.alchemy.com/v2/{{api_key}}
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "trace_get",
    "params": [
      "0x07104ffdf32b06b90e604f23c7b4e21fc985b68c5bb8c13140d0d3d2e151a385",
      [
        "0x0"
      ]
    ],
    "id": 1
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns a specific trace by transaction hash and trace address path.
  Args:
  - txHash: 32-byte hash
  - traceAddress: array of integers (hex) describing call path.
  Returns: Single trace object or null.
}
